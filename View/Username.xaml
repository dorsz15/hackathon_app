<UserControl x:Class="electrolytes.View.Username"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:electrolytes.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <TextBlock Style="{StaticResource MainText}"
                   HorizontalAlignment="Center"
                   Margin="0 0 0 60">Tell us something about yourself</TextBlock>

        <TextBlock Style="{StaticResource MainText}"
                   HorizontalAlignment="Left"
                   FontSize="20"
                   Margin="40 0 0 10">
            Nickname
        </TextBlock>
        <Border Style="{StaticResource InputBackground}" Height="100">
            <TextBox Style="{StaticResource Input}"></TextBox>
        </Border>

        <Grid Margin="40 40 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="1" Grid.Column="0">
                <TextBlock Style="{StaticResource MainText}" 
                   Margin="0,0,0,5"
                   FontSize="20"
>
                    Sex
                </TextBlock>
                <Border Style="{StaticResource InputBackground}" 
                    Height="40"
                    Width="150"
                    HorizontalAlignment="Left">
                    <TextBox Style="{StaticResource Input}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1">
                <TextBlock Style="{StaticResource MainText}" 
                   Margin="0,0,0,5"
                   FontSize="20">
                    Age
                </TextBlock>
                <Border Style="{StaticResource InputBackground}" 
                    Height="40"
                    Width="150"
                    HorizontalAlignment="Left"> 
                    <TextBox Style="{StaticResource Input}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="2">
                <TextBlock Style="{StaticResource MainText}" 
                   Margin="0,0,0,5"
                   FontSize="20">
                    Weight
                </TextBlock>
                <Border Style="{StaticResource InputBackground}" 
                    Height="40"
                    Width="150"
                    HorizontalAlignment="Left">
                    <TextBox Style="{StaticResource Input}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="3">
                <TextBlock Style="{StaticResource MainText}" 
                   Margin="0,0,0,5"
                   FontSize="20">
                    Height
                </TextBlock>
                <Border Style="{StaticResource InputBackground}" 
                    Height="40"
                    Width="150"
                    HorizontalAlignment="Left">
                    <TextBox Style="{StaticResource Input}" />
                </Border>
            </StackPanel>

        </Grid>
    </StackPanel>
</UserControl>
